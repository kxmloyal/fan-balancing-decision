/* index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-section {
  margin-bottom: 40rpx;
}

.page-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.chart-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.ec-canvas {
  width: 100%;
  height: 400rpx;
}

@media (max-width: 375px) {
  .ec-canvas {
    height: 350rpx;
  }
}

@media (min-width: 768px) {
  .ec-canvas {
    height: 500rpx;
  }
}

/* 加载状态样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.loading::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 错误提示样式 */
.error {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  color: #e74c3c;
  text-align: center;
  padding: 20rpx;
}

.error-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 24rpx;
  line-height: 1.5;
}